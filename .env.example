# Server-side Gemini credentials. Never expose this as NEXT_PUBLIC_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Neon writes these values during `neon deploy` / `neon env pull`.
# Use the pooled URL for application traffic and the direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Server-only Bright Data Web Unlocker credentials for offline ingestion.
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=

# Frontend analysis mode. Must be exactly "false" to call live APIs.
# Leave true only for local UI work against the demo fixture.
NEXT_PUBLIC_USE_MOCK_ANALYSIS=false

# Public ElevenLabs agent id (browser-visible). Never put the tool secret
# or any provider API key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Server-only secret for POST /api/agent/tools (X-Agent-Tool-Secret).
ELEVENLABS_TOOL_SECRET=
