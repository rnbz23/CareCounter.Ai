# Frontend uses mock analysis until Raja's API is available.
# Set to "false" once GET /api/analyses/:id returns real Analysis data.
NEXT_PUBLIC_USE_MOCK_ANALYSIS=true

# Public ElevenLabs agent id. Safe to expose to the browser; never put the
# agent tool secret or an API key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxx
